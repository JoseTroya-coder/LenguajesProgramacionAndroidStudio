<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Botón para regresar conectado al método Java -->
    <Button
        android:id="@+id/btnregresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Regresar"
        android:onClick="Regresar" />

    <!-- Texto que se muestra si la tabla está vacía -->
    <TextView
        android:id="@+id/txtvacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aún no hay personas registradas"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Scroll vertical para poder bajar si hay muchas filas -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Scroll horizontal para poder mover a los lados si las columnas son muy anchas -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- La tabla donde tu clase DynamicTable inyectará los datos -->
            <TableLayout
                android:id="@+id/tblistado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TableLayout>

        </HorizontalScrollView>

    </ScrollView>

</LinearLayout>